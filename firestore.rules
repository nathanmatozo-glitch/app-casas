rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(data) {
      return signedIn() && data.ownerUid == request.auth.uid;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function propertyFieldsAreAllowed(data) {
      return data.keys().hasOnly([
        'ownerUid', 'title', 'dealType', 'category', 'neighborhood', 'city',
        'state', 'postalCodePrefix', 'price', 'condoFee', 'propertyTax', 'area',
        'bedrooms', 'bathrooms', 'parkingSpaces', 'description', 'status',
        'photos', 'phonePublished', 'whatsappAvailable',
        'fullAddressPublished', 'publicAddress', 'latitude', 'longitude',
        'createdAt', 'updatedAt'
      ]);
    }

    function propertyPrivacyIsValid(data) {
      return (!('phonePublished' in data.keys())
          || data.phonePublished is bool)
        && (!('fullAddressPublished' in data.keys())
          || data.fullAddressPublished is bool)
        && (!('whatsappAvailable' in data.keys())
          || (data.whatsappAvailable is bool
            && (!data.whatsappAvailable
              || data.get('phonePublished', false) == true)))
        && (!('publicAddress' in data.keys())
          || (data.get('fullAddressPublished', false) == true
            && data.publicAddress is string
            && data.publicAddress.size() > 0))
        && (data.get('fullAddressPublished', false) != true
          || ('publicAddress' in data.keys()));
    }

    function validNewProperty(data) {
      return data.keys().hasAll([
          'ownerUid', 'title', 'dealType', 'category', 'neighborhood', 'city',
          'state', 'price', 'description', 'status', 'photos',
          'phonePublished', 'fullAddressPublished'
        ])
        && propertyFieldsAreAllowed(data)
        && propertyPrivacyIsValid(data)
        && data.ownerUid is string
        && data.title is string
        && data.title.size() > 0
        && data.dealType in ['rent', 'buy']
        && data.category in ['apartment', 'studio', 'house', 'gatedHouse']
        && data.neighborhood is string
        && data.city is string
        && data.state is string
        && data.price is number
        && data.price > 0
        && data.description is string
        && data.description.size() <= 800
        && data.photos is list
        && data.photos.size() > 0
        && data.photos.size() <= 10;
    }

    function privateDetailsFieldsAreAllowed(data) {
      return data.keys().hasOnly([
        'ownerUid', 'street', 'number', 'complement', 'postalCode',
        'advertiserName'
      ])
        && data.ownerUid is string
        && (!('street' in data.keys()) || data.street is string)
        && (!('number' in data.keys()) || data.number is string)
        && (!('complement' in data.keys()) || data.complement is string)
        && (!('postalCode' in data.keys()) || data.postalCode is string)
        && (!('advertiserName' in data.keys()) || data.advertiserName is string);
    }

    function contactFieldsAreAllowed(data) {
      return data.keys().hasOnly(['ownerUid', 'phone'])
        && data.ownerUid is string
        && data.phone is string;
    }

    match /properties/{propertyId} {
      allow get, list: if resource.data.status == 'active' || owns(resource.data);

      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'active'
        && validNewProperty(request.resource.data);

      allow update: if owns(resource.data)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && propertyFieldsAreAllowed(request.resource.data)
        && propertyPrivacyIsValid(request.resource.data);

      allow delete: if owns(resource.data);
    }

    match /propertyPrivate/{propertyId} {
      allow get: if owns(resource.data);
      allow list: if false;

      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && privateDetailsFieldsAreAllowed(request.resource.data)
        && getAfter(/databases/$(database)/documents/properties/$(propertyId)).data.ownerUid
          == request.auth.uid;

      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && privateDetailsFieldsAreAllowed(request.resource.data);

      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /propertyContacts/{propertyId} {
      function listing() {
        return get(/databases/$(database)/documents/properties/$(propertyId));
      }

      allow get: if signedIn() && (
        owns(resource.data)
        || (listing().data.status == 'active'
            && listing().data.phonePublished == true)
      );
      allow list: if false;

      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && contactFieldsAreAllowed(request.resource.data)
        && getAfter(/databases/$(database)/documents/properties/$(propertyId)).data.ownerUid
          == request.auth.uid;

      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && contactFieldsAreAllowed(request.resource.data);

      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /users/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /users/{userId}/favorites/{propertyId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.propertyId is string
        && request.resource.data.reason is string
        && request.resource.data.reason.size() <= 120;
      allow read, update, delete: if isAdmin();
    }
  }
}
