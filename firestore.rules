rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(data) {
      return signedIn() && data.ownerUid == request.auth.uid;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    match /properties/{propertyId} {
      allow get, list: if resource.data.status == 'active' || owns(resource.data);

      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'active'
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.price is number
        && request.resource.data.price > 0;

      allow update: if owns(resource.data)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.keys().hasOnly([
          'ownerUid', 'title', 'dealType', 'category', 'neighborhood', 'city',
          'state', 'postalCodePrefix', 'price', 'condoFee', 'propertyTax', 'area', 'bedrooms',
          'bathrooms', 'parkingSpaces', 'description', 'status', 'photos',
          'phonePublished', 'fullAddressPublished', 'publicAddress',
          'latitude', 'longitude', 'createdAt', 'updatedAt'
        ]);

      allow delete: if owns(resource.data);
    }

    match /propertyPrivate/{propertyId} {
      allow get: if owns(resource.data);
      allow list: if false;

      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/properties/$(propertyId)).data.ownerUid
          == request.auth.uid;

      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid;

      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /propertyContacts/{propertyId} {
      function listing() {
        return get(/databases/$(database)/documents/properties/$(propertyId));
      }

      allow get: if signedIn() && (
        owns(resource.data)
        || (listing().data.status == 'active'
            && listing().data.phonePublished == true)
      );
      allow list: if false;

      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/properties/$(propertyId)).data.ownerUid
          == request.auth.uid;

      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid;

      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /users/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /users/{userId}/favorites/{propertyId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.propertyId is string
        && request.resource.data.reason is string
        && request.resource.data.reason.size() <= 120;
      allow read, update, delete: if isAdmin();
    }
  }
}
